# Local development values. Copy to .env and adjust.
# Inside Docker, compose overrides these with container-local addresses —
# see compose.yaml for why those differ.

# Host-facing gateway port. The container always listens on 8080; compose
# publishes it as 9051:8080 (prod) or the same host port in dev.
PORT=9051

# Where catalog is, from the perspective of whoever is running this.
#   locally:  the catalog container's published host port
#   in docker: the catalog compose service name (http://app:8080)
# Both are the same code — only this value changes (ADR-009).
CATALOG_SERVICE_URL=http://localhost:9050

# dev | prod. Controls logging format and whether .env is auto-loaded.
# Must be exactly "prod" in production so the app never reads a file.
ENV=development
