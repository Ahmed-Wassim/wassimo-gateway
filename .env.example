# Local development values. Copy to .env and adjust.
# Inside Docker, compose overrides these with container-local addresses —
# see compose.yaml for why those differ.

# Host-facing gateway port. The container always listens on 8080; compose
# publishes it as 9051:8080 (dev) or 9071:8080 (prod).
PORT=9051

# Where catalog is, from the perspective of whoever is running this.
#   locally:  the catalog container's published host port
#   in docker: the catalog compose service name (http://catalog:8080)
# Both are the same code — only this value changes (ADR-009).
CATALOG_SERVICE_URL=http://localhost:9050

# Where identity is, same perspective rule as above.
#   locally:  the identity container's published host port
#   in docker: the identity compose service name (http://identity:8000)
IDENTITY_SERVICE_URL=http://localhost:9075

# dev | prod. Controls logging format and whether .env is auto-loaded.
# Must be exactly "prod" in production so the app never reads a file.
ENV=development

# Ed25519 public key the gateway uses to verify identity access JWTs.
# Copy the full value from identity's storage/app/jwt/public.key
# (generate with `php artisan jwt:keys`). Must decode to 32 bytes —
# a shorter value is a truncated copy and rejects every token.
JWT_PUBLIC_KEY=PASTE_FULL_PUBLIC_KEY_FROM_IDENTITY_HERE
JWT_ISSUER=wassimo-identity
JWT_AUDIENCE=wassimo-gateway
# Must match identity's JWT_KID (config/jwt.php). Empty means accept any kid.
JWT_KID=ed25519-1

# Where cart is, same perspective rule as above.
#   locally:  the cart container's published host port
#   in docker: the cart compose service name (http://cart:8080)
CART_SERVICE_URL=http://localhost:9052
